# Modelo do Secret de PROD (credenciais). Para usar:
#   cp deploy/openshift/prod/secret.env.example deploy/openshift/prod/secret.env   (e depois preencha o secret.env)
# O secret.env é ignorado pelo Git e pelo build da imagem: nunca o commite, nem o envie por e-mail ou chat em texto claro.
# Um KEY=VALOR por linha, sem aspas (elas entram no valor). Os valores são literais.
# Opção B (Secret criado fora do repositório, README, passo 2.2): este arquivo não é usado.
# As chaves opcionais podem ficar vazias. As obrigatórias são validadas por check.sh.

# Client ID da aplicação Adobe Sign (produção)
CLIENT_ID=
# Client secret da aplicação Adobe Sign (produção)
CLIENT_SECRET=
# Segredo HMAC compartilhado com o WebReport (valida a assinatura da chamada /start)
SIGNATURE_SECRET=
# Usuário do Basic Auth (/admin/*, /logs)
LOG_USER=
# Senha do Basic Auth (/admin/*, /logs)
LOG_PASS=
# Opcional: Basic Auth próprio do POST /auth (a credencial embutida no WebReport). Preencha as DUAS ou nenhuma:
# sem elas vale LOG_USER/LOG_PASS. Use valores diferentes de LOG_*: a do WebReport fica visível no HTML.
START_AUTH_USER=
START_AUTH_PASS=
# Opcional: credencial Basic própria do modo direto do cancelamento (POST /cancel/direct/auth). Preencha as DUAS ou nenhuma;
# sem elas vale a credencial do /auth. Ver server/config/index.js e webreports/cancelacion/README.md.
CANCEL_DIRECT_AUTH_USER=
CANCEL_DIRECT_AUTH_PASS=
# Usuário do OTCS (OTDS) usado pela integração
OTCS_USER=
# Senha do OTCS (OTDS) usada pela integração
OTCS_PASS=
# Opcional: refresh token do Adobe. Deixe VAZIO e autorize em /admin/login, que grava tokens.json no volume.
ADOBE_REFRESH_TOKEN=
