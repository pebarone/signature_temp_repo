# Valores de PROD que mudam por deploy. ÚNICO arquivo a editar para um deploy de PROD (além de secret.env, com as credenciais).
# Regras: um KEY=VALOR por linha; sem aspas (elas entram no valor); sem valor vazio; comentários só em linha própria.
# Depois de editar, rode: sh deploy/openshift/check.sh   e, se não houver ERROR: oc apply -k deploy/openshift/prod
# Os valores entram por substituição no kustomize (ver prod/kustomization.yaml). Não edite os manifestos.

# Namespace (projeto) onde tudo é criado. Precisa existir antes: oc new-project <namespace>
NAMESPACE=<namespace>

# URL pública do orquestrador: só a origem (https://host), sem caminho e sem barra no fim. O host da Route sai daqui.
# É o host do orquestrador atual de PROD: o webhook do Adobe e o SERVER_URL dos WebReports já apontam para ele.
# Se o host mudar: atualize o webhook, o redirect URI no Adobe e o SERVER_URL dos WebReports (README, seção 3).
# Enquanto a Route antiga tiver o mesmo host, a nova fica com HostAlreadyClaimed (README, passo 2.7).
PUBLIC_URL=https://co-saphcm-ms-md-co-sign-empcontract-prod.apps.osftd4.colsanitas.com

# Imagem do orquestrador, referência completa: <registry>/<namespace>/signature-orchestrator:<tag>. Não use latest.
# Sugestão de tag: o hash curto do commit (git rev-parse --short HEAD). Registry interno do OpenShift:
# image-registry.openshift-image-registry.svc:5000/<namespace>/signature-orchestrator:<tag> (README, passo 2.5).
IMAGE=<registry>/<namespace>/signature-orchestrator:<tag>

# StorageClass do volume do SQLite. OBRIGATÓRIA, e precisa ser de BLOCO com ReadWriteOnce (ext4 ou xfs).
# Exemplos: ocs-storagecluster-ceph-rbd, gp3-csi, managed-csi, thin-csi, standard-csi.
# Nunca NFS, CephFS, EFS, Azure Files ou ReadWriteMany. Listar com: oc get storageclass (README, seções 1.2 a 1.4).
# Depois que o PVC é criado, a classe não pode ser trocada.
STORAGE_CLASS=<classe-de-bloco>

# Tamanho do PVC. 2Gi é o valor de referência do repositório (README, seção 1.5).
STORAGE_SIZE=2Gi

# Base da API do Content Server (OTCS), sem barra no fim. O código acrescenta /v1 e /v2.
OTCS_BASE=https://otcs.g115.opentext.cloud/cs/cs/api

# Região do Adobe Sign de PROD (NA4). API e OAuth são hosts diferentes. O padrão do código é EU1, por isso os dois são definidos aqui.
ADOBE_API_BASE=https://api.na4.adobesign.com
ADOBE_AUTH_BASE=https://secure.na4.adobesign.com

# Origens permitidas por CORS em /auth e /start, separadas por vírgula e sem espaço. Em PROD: o OTCS de produção.
CORS_ORIGINS=https://otcs.g115.opentext.cloud

# Cancelamento de fluxos (ver webreports/cancelacion/README.md). "false" mantém o comportamento atual de PROD.
# CANCEL_ENABLED liga o cancelamento pelo WebReport da tarefa; CANCEL_DIRECT_ENABLED liga o modo direto (WebReport sozinho).
CANCEL_ENABLED=false
CANCEL_DIRECT_ENABLED=false
